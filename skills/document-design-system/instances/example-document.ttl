@prefix dds: <https://example.org/ontology/dds#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix structure: <https://example.org/data/structure/> .
@prefix semantic: <https://example.org/data/semantic/> .
@prefix presentation: <https://example.org/data/presentation/> .
@prefix design: <https://example.org/data/design/> .
@prefix doc: <https://example.org/data/doc/> .
@prefix component: <https://example.org/data/component/> .

# Example planning document (fictional). Requires instances/design-system.ttl.
# Note: unlike the original spec example, every component is reachable from the
# Document (root via hasComponent, descendants via hasChild).

doc:proposal a dds:Document ;
    skos:prefLabel "AI 상담 시스템 기획안"@ko ;
    dds:usesDesignSystem design:PlanningSystem ;
    dds:hasComponent component:proposal\/overview , component:proposal\/scope .

component:proposal\/overview a dds:Component ;
    dds:hasStructure structure:Section ;
    dds:hasOrder 1 ;
    dds:hasChild component:proposal\/overview-title , component:proposal\/REQ001 .

component:proposal\/overview-title a dds:Component ;
    dds:hasStructure structure:Heading ;
    dds:hasPresentation presentation:Heading1 ;
    dds:hasOrder 1 ;
    dds:hasContent "프로젝트 개요"@ko .

component:proposal\/REQ001 a dds:Component ;
    dds:hasStructure structure:Paragraph ;
    dds:hasSemantic semantic:Requirement ;
    dds:hasPresentation presentation:Body ;
    dds:hasOrder 2 ;
    dds:hasContent "환불 가능 여부를 판단해야 한다."@ko .

component:proposal\/scope a dds:Component ;
    dds:hasStructure structure:Section ;
    dds:hasOrder 2 ;
    dds:hasChild component:proposal\/scope-title , component:proposal\/scope-list .

component:proposal\/scope-title a dds:Component ;
    dds:hasStructure structure:Heading ;
    dds:hasOrder 1 ;
    dds:hasContent "범위"@ko .

component:proposal\/scope-list a dds:Component ;
    dds:hasStructure structure:List ;
    dds:ordered true ;
    dds:hasOrder 2 ;
    dds:hasChild component:proposal\/scope-list-i1 , component:proposal\/scope-list-i2 .

component:proposal\/scope-list-i1 a dds:Component ;
    dds:hasStructure structure:ListItem ;
    dds:hasSemantic semantic:Constraint , semantic:Policy ;
    dds:hasOrder 1 ;
    dds:hasContent "개인정보는 마스킹된 상태로만 처리한다."@ko .

component:proposal\/scope-list-i2 a dds:Component ;
    dds:hasStructure structure:ListItem ;
    dds:hasOrder 2 ;
    dds:hasContent "1차 범위는 환불 문의로 한정한다."@ko .
