@prefix dds: <https://example.org/ontology/dds#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix structure: <https://example.org/data/structure/> .
@prefix semantic: <https://example.org/data/semantic/> .
@prefix design: <https://example.org/data/design/> .
@prefix resolution: <https://example.org/data/resolution/> .
@prefix doc: <https://example.org/data/doc/> .
@prefix c: <https://example.org/data/component/deliberation-lib/> .

# Component library for DeliberationSystem (ABox, validated like any document).
# scripts/gen_builder.py turns each prototype into a builder method named after its local id.
# Overview is not a semantic: `overview` is a plain paragraph whose role comes from its position
# (leading content of a Section, or a root paragraph = document overview).
# Links on prototypes (counters, targets, resolution) only keep the library itself SHACL-valid;
# the builder never copies them. Pass links per document as keyword arguments.
# To add a component: add a root here (unique hasOrder), validate, regenerate the builder.

doc:deliberation-lib a dds:Document ;
    skos:prefLabel "Deliberation component library"@en ;
    dds:usesDesignSystem design:DeliberationSystem ;
    dds:hasComponent c:section , c:heading , c:overview , c:description , c:problem , c:goal , c:scope , c:decision_question , c:criterion , c:assumption , c:alternative , c:claim , c:evidence , c:rationale , c:counterargument , c:perspective , c:risk , c:critique , c:unresolved_issue , c:decision , c:bullet_list , c:table .

c:section a dds:Component ; dds:hasStructure structure:Section ; dds:hasOrder 1 .
c:heading a dds:Component ; dds:hasStructure structure:Heading ; dds:hasOrder 2 ; dds:hasContent "heading"@en .
c:overview a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasOrder 3 ;
    dds:hasContent "overview"@en .
c:description a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Description ; dds:hasOrder 4 ;
    dds:hasContent "description"@en .
c:problem a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Problem ; dds:hasOrder 5 ;
    dds:hasContent "problem"@en .
c:goal a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Goal ; dds:hasOrder 6 ;
    dds:hasContent "goal"@en .
c:scope a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Scope ; dds:hasOrder 7 ;
    dds:hasContent "scope"@en .
c:decision_question a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:DecisionQuestion ; dds:hasOrder 8 ;
    dds:hasContent "decision question"@en .
c:criterion a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Criterion ; dds:hasOrder 9 ;
    dds:hasContent "criterion"@en .
c:assumption a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Assumption ; dds:hasOrder 10 ;
    dds:hasContent "assumption"@en .
c:alternative a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Alternative ; dds:hasOrder 11 ;
    dds:hasContent "alternative"@en .
c:claim a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Claim ; dds:hasOrder 12 ;
    dds:hasContent "claim"@en .
c:evidence a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Evidence ; dds:hasOrder 13 ;
    dds:hasContent "evidence"@en .
c:rationale a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Rationale ; dds:hasOrder 14 ;
    dds:hasContent "rationale"@en .
c:counterargument a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Counterargument ; dds:counters c:claim ; dds:hasOrder 15 ;
    dds:hasContent "counterargument"@en .
c:perspective a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Perspective ; dds:hasOrder 16 ;
    dds:hasContent "perspective"@en .
c:risk a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Risk ; dds:hasOrder 17 ;
    dds:hasContent "risk"@en .
c:critique a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Critique ; dds:targets c:claim ; dds:resolution resolution:accepted ; dds:hasOrder 18 ;
    dds:hasContent "critique"@en .
c:unresolved_issue a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:UnresolvedIssue ; dds:hasOrder 19 ;
    dds:hasContent "unresolved issue"@en .
c:decision a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasSemantic semantic:Decision ; dds:hasOrder 20 ;
    dds:hasContent "decision"@en .
c:bullet_list a dds:Component ; dds:hasStructure structure:List ; dds:ordered false ; dds:hasOrder 21 ;
    dds:hasChild c:list_item , c:alternative_item , c:risk_item , c:criterion_item .
c:list_item a dds:Component ; dds:hasStructure structure:ListItem ; dds:hasOrder 1 ; dds:hasContent "item"@en .
c:alternative_item a dds:Component ; dds:hasStructure structure:ListItem ; dds:hasSemantic semantic:Alternative ; dds:hasOrder 2 ; dds:hasContent "alternative"@en .
c:risk_item a dds:Component ; dds:hasStructure structure:ListItem ; dds:hasSemantic semantic:Risk ; dds:hasOrder 3 ; dds:hasContent "risk"@en .
c:criterion_item a dds:Component ; dds:hasStructure structure:ListItem ; dds:hasSemantic semantic:Criterion ; dds:hasOrder 4 ; dds:hasContent "criterion"@en .
c:table a dds:Component ; dds:hasStructure structure:Table ; dds:hasOrder 22 ; dds:hasChild c:table_row .
c:table_row a dds:Component ; dds:hasStructure structure:TableRow ; dds:hasOrder 1 ;
    dds:hasChild c:cell , c:alternative_cell , c:criterion_cell , c:evidence_cell .
c:cell a dds:Component ; dds:hasStructure structure:TableCell ; dds:hasOrder 1 ; dds:hasContent "cell"@en .
c:alternative_cell a dds:Component ; dds:hasStructure structure:TableCell ; dds:hasSemantic semantic:Alternative ; dds:hasOrder 2 ; dds:hasContent "alternative"@en .
c:criterion_cell a dds:Component ; dds:hasStructure structure:TableCell ; dds:hasSemantic semantic:Criterion ; dds:hasOrder 3 ; dds:hasContent "criterion"@en .
c:evidence_cell a dds:Component ; dds:hasStructure structure:TableCell ; dds:hasSemantic semantic:Evidence ; dds:hasOrder 4 ; dds:hasContent "evidence"@en .
