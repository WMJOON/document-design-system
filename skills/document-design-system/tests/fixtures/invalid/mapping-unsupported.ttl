# INVALID (mapping-unsupported): Frame maps Description to presentation:Compact, which DeliberationSystem does not support.
@prefix dds: <https://example.org/ontology/dds#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix structure: <https://example.org/data/structure/> .
@prefix semantic: <https://example.org/data/semantic/> .
@prefix presentation: <https://example.org/data/presentation/> .
@prefix design: <https://example.org/data/design/> .
@prefix frame: <https://example.org/data/frame/> .
@prefix doc: <https://example.org/data/doc/> .
@prefix component: <https://example.org/data/component/> .

frame:t a dds:DocumentFrame ; skos:prefLabel "Test frame"@en ;
    dds:hasRequirement frame:t-req ;
    dds:definesPresentationMapping frame:t-map .
frame:t-req a dds:FrameRequirement ; dds:requiredSemantic semantic:Description ; dds:minOccurs 1 .
frame:t-map a dds:SemanticBinding ; dds:forSemantic semantic:Description ; dds:mappedPresentation presentation:Compact .
doc:x a dds:Document ; dds:usesDesignSystem design:DeliberationSystem ; dds:usesFrame frame:t ;
    dds:hasComponent component:x\/p .
component:x\/p a dds:Component ; dds:hasStructure structure:Paragraph ; dds:hasOrder 1 ;
    dds:hasSemantic semantic:Description ; dds:hasContent "본문"@ko .
